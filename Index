<!DOCTYPE html>
<html lang="th" data-lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>L. ASH — Creative Archive & Studio</title>
    <style>
        :root {
            --bg-color: #080808;
            --surface-color: #121212;
            --surface-hover: #1a1a1a;
            --border-color: #222222;
            --border-hover: #333333;
            --text-main: #f3f3f3;
            --text-secondary: #999999;
            --text-muted: #666666;
            --accent: #b0b0b0;
            --font-heading: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-body);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* --- LANGUAGE GATE / LANDING SCREEN --- */
        #lang-gate {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: var(--bg-color);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s;
            padding: 2rem;
        }

        #lang-gate.fade-out {
            opacity: 0;
            visibility: hidden;
        }

        .gate-content {
            text-align: center;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .gate-title {
            font-family: var(--font-heading);
            font-size: clamp(3.5rem, 8vw, 6rem);
            font-weight: 700;
            letter-spacing: 0.25em;
            margin-bottom: 1.25rem;
            color: var(--text-main);
        }

        .gate-subtitle {
            font-size: clamp(0.95rem, 1.8vw, 1.15rem);
            color: var(--text-secondary);
            margin-bottom: 2.5rem;
            letter-spacing: 0.05em;
            line-height: 1.8;
            font-weight: 300;
        }

        .gate-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-bottom: 3rem;
        }

        .lang-btn {
            background: transparent;
            border: 1px solid var(--border-hover);
            color: var(--text-main);
            font-family: var(--font-heading);
            font-size: 0.9rem;
            font-weight: 500;
            padding: 0.8rem 2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            letter-spacing: 0.1em;
        }

        .lang-btn:hover {
            background: var(--text-main);
            color: var(--bg-color);
            border-color: var(--text-main);
            transform: translateY(-2px);
        }

        .gate-footer-note {
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .gate-contact {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1.5rem;
            border-top: 1px solid var(--border-color);
            padding-top: 1.5rem;
            width: 100%;
        }

        .gate-contact-link {
            color: var(--text-secondary);
            text-decoration: none;
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 0.15em;
            transition: color 0.2s;
            text-transform: uppercase;
        }

        .gate-contact-link:hover {
            color: var(--text-main);
        }

        /* --- MAIN APP WRAPPER --- */
        #app {
            opacity: 0;
            transition: opacity 0.8s ease 0.2s;
        }

        #app.visible {
            opacity: 1;
        }

        /* --- NAVIGATION --- */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: rgba(8, 8, 8, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 5%;
        }

        .nav-logo {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            color: var(--text-main);
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: var(--text-main);
        }

        .lang-switch {
            background: transparent;
            border: 1px solid var(--border-hover);
            color: var(--text-secondary);
            font-size: 0.75rem;
            padding: 0.3rem 0.7rem;
            cursor: pointer;
            font-family: var(--font-heading);
            letter-spacing: 0.1em;
            transition: all 0.2s;
        }

        .lang-switch:hover {
            color: var(--text-main);
            border-color: var(--text-secondary);
        }

        /* --- LAYOUT CONTAINER --- */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 5%;
        }

        section {
            padding: 7rem 0 5rem 0;
            border-bottom: 1px solid var(--border-color);
        }

        section:last-of-type {
            border-bottom: none;
        }

        /* --- HERO SECTION --- */
        .hero {
            min-height: 90vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding-top: 8rem;
        }

        .hero-title {
            font-family: var(--font-heading);
            font-size: clamp(3rem, 7vw, 5.5rem);
            font-weight: 700;
            letter-spacing: 0.15em;
            margin-bottom: 1.5rem;
            line-height: 1.1;
        }

        .hero-subtitle {
            font-size: clamp(1.1rem, 2vw, 1.35rem);
            color: var(--text-secondary);
            max-width: 650px;
            margin-bottom: 2.5rem;
            line-height: 1.7;
            font-weight: 300;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background: transparent;
            color: var(--text-main);
            border: 1px solid var(--border-hover);
            padding: 0.9rem 1.8rem;
            font-family: var(--font-heading);
            font-size: 0.85rem;
            letter-spacing: 0.1em;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            width: fit-content;
        }

        .btn-primary:hover {
            background: var(--text-main);
            color: var(--bg-color);
            border-color: var(--text-main);
            transform: translateX(4px);
        }

        /* --- SECTION HEADINGS --- */
        .section-header {
            margin-bottom: 3.5rem;
        }

        .section-tag {
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 0.2em;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 0.75rem;
            display: block;
        }

        .section-title {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 4vw, 2.8rem);
            font-weight: 700;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

        .section-desc {
            color: var(--text-secondary);
            font-size: 1rem;
            max-width: 600px;
        }

        /* --- FEATURED CARD --- */
        .featured-card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            padding: 3rem;
            margin-top: 3rem;
            transition: border-color 0.3s ease;
        }

        .featured-card:hover {
            border-color: var(--border-hover);
        }

        .featured-badge {
            font-family: var(--font-heading);
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            text-transform: uppercase;
        }

        .featured-meta {
            font-size: 0.85rem;
            color: var(--accent);
            letter-spacing: 0.1em;
            margin-bottom: 0.75rem;
            font-family: var(--font-heading);
        }

        .featured-heading {
            font-family: var(--font-heading);
            font-size: 2rem;
            margin-bottom: 1rem;
            letter-spacing: 0.03em;
        }

        .featured-text {
            color: var(--text-secondary);
            margin-bottom: 2rem;
            max-width: 700px;
            font-size: 1.05rem;
            line-height: 1.7;
        }

        /* --- WORKS GRID --- */
        .works-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .work-card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s ease;
        }

        .work-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-2px);
        }

        .work-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1.5rem;
        }

        .work-num {
            font-family: var(--font-heading);
            font-size: 0.85rem;
            color: var(--text-muted);
            letter-spacing: 0.1em;
        }

        .work-cat {
            font-family: var(--font-heading);
            font-size: 0.75rem;
            color: var(--accent);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .work-title {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            margin-bottom: 1rem;
            letter-spacing: 0.03em;
        }

        .work-desc {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-bottom: 2rem;
            line-height: 1.7;
        }

        .work-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-main);
            text-decoration: none;
            font-family: var(--font-heading);
            font-size: 0.85rem;
            letter-spacing: 0.1em;
            transition: color 0.2s;
        }

        .work-link:hover {
            color: var(--accent);
        }

        /* --- LAB GRID --- */
        .lab-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .lab-card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: border-color 0.3s;
        }

        .lab-card:hover {
            border-color: var(--border-hover);
        }

        .lab-status {
            font-family: var(--font-heading);
            font-size: 0.7rem;
            letter-spacing: 0.15em;
            padding: 0.25rem 0.6rem;
            border: 1px solid var(--border-hover);
            width: fit-content;
            margin-bottom: 1.25rem;
            color: var(--accent);
            text-transform: uppercase;
        }

        .lab-title {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            margin-bottom: 0.75rem;
        }

        .lab-desc {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* --- CAD SERVICES SECTION --- */
        .cad-container {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            padding: 3rem;
            margin-top: 2rem;
        }

        .cad-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-bottom: 2.5rem;
        }

        .cad-box h3 {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            margin-bottom: 1rem;
            color: var(--text-main);
            letter-spacing: 0.05em;
        }

        .cad-box ul {
            list-style: none;
        }

        .cad-box ul li {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-bottom: 0.5rem;
            position: relative;
            padding-left: 1.2rem;
        }

        .cad-box ul li::before {
            content: "—";
            position: absolute;
            left: 0;
            color: var(--text-muted);
        }

        .cad-footer-box {
            border-top: 1px solid var(--border-color);
            padding-top: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .cad-note {
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.7;
        }

        /* --- ABOUT --- */
        .about-content {
            max-width: 750px;
            font-size: 1.15rem;
            color: var(--text-secondary);
            line-height: 1.9;
            font-weight: 300;
        }

        .about-content p {
            margin-bottom: 1.5rem;
        }

        /* --- CONTACT --- */
        .contact-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .contact-btn {
            display: inline-flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 1rem 1.8rem;
            text-decoration: none;
            font-family: var(--font-heading);
            font-size: 0.85rem;
            letter-spacing: 0.1em;
            transition: all 0.3s ease;
        }

        .contact-btn:hover {
            background-color: var(--surface-hover);
            border-color: var(--border-hover);
            transform: translateY(-2px);
        }

        .contact-sub {
            font-size: 0.75rem;
            color: var(--text-secondary);
            font-weight: 300;
            letter-spacing: 0.05em;
        }

        /* --- FOOTER --- */
        footer {
            padding: 4rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            font-size: 0.85rem;
            color: var(--text-muted);
            font-family: var(--font-heading);
            letter-spacing: 0.1em;
        }

        .footer-logo {
            color: var(--text-main);
            text-decoration: none;
            font-weight: 700;
            letter-spacing: 0.2em;
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
            .featured-card, .cad-container {
                padding: 1.5rem;
            }
            .contact-links {
                grid-template-columns: 1fr;
            }
            .gate-contact {
                flex-direction: column;
                gap: 1rem;
            }
            footer {
                flex-direction: column;
                gap: 1.5rem;
                text-align: center;
            }
        }
    </style>
</head>
